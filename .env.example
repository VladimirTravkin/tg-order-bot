# ============================================
# tg-order-bot — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================

# --- Telegram ---
# Get your token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated Telegram user IDs with admin access
# Get your ID from @userinfobot
ADMIN_IDS=123456789

# --- Database ---
# PostgreSQL DSN with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_order_bot

# --- Redis ---
# Redis DSN for FSM state storage
REDIS_URL=redis://localhost:6379/0

# --- Application ---
# Runtime environment: dev | prod
ENVIRONMENT=dev

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
